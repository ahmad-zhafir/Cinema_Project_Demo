<?xml version="1.0" encoding="UTF-8"?>
<project name="CinemaTicketBookingSystem" default="default" basedir=".">
    <description>Builds, tests, and runs the project CinemaTicketBookingSystem.</description>

    <!-- Import the NetBeans auto-generated build -->
    <import file="nbproject/build-impl.xml"/>

    <!--
        Customizations:
        - Pre-compile target ensures lib.dir exists for runtime libraries (e.g., JDatePicker)
    -->

    <target name="-pre-compile">
        <!-- Set lib.dir property if not already set -->
        <property name="lib.dir" value="build/lib"/>

        <!-- Create the directory if it doesn't exist -->
        <mkdir dir="${lib.dir}"/>
    </target>

    <!--
        Optional: You can add more pre/post hooks here if needed
        Examples:
        -post-compile: for obfuscation, extra steps
        -pre-jar / -post-jar: for JAR customization
    -->

</project>
